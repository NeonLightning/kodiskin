<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addons>
<addon id="skin.terminal80" name="Terminal 80" provider-name="Terminal 80 Project" version="1.0.13">
    <requires>
        <import addon="xbmc.gui" version="5.17.0" />
        <import addon="script.skinshortcuts" version="1.0.0" />
        <import addon="plugin.video.themoviedb.helper" version="4.4.0" />
        <import addon="script.image.resource.select" version="3.0.2" />
    </requires>
    <extension debugging="false" effectslowdown="1.00" point="xbmc.gui.skin">
        <res aspect="16:9" default="true" folder="16x9" height="1080" width="1920" />
    </extension>
    <extension point="xbmc.addon.metadata">
        <platform>all</platform>
        <summary lang="en_GB">A phosphor-green cyber terminal interface for Kodi.</summary>
        <summary lang="hu_HU">Foszforzöld terminálfelület a Kodihoz.</summary>
        <summary lang="it_IT">Un'interfaccia per Kodi in stile terminale verde fosforo.</summary>
        <summary lang="zh_CN">适用于 Kodi 的荧光绿终端风格界面。</summary>
        <disclaimer lang="en_GB">Mouse and Touch device not supported</disclaimer>
        <disclaimer lang="hu_HU">Egér és érintőpad eszköz nem támogatott</disclaimer>
        <disclaimer lang="it_IT">Mouse e dispositivi touch non sono supportati</disclaimer>
        <disclaimer lang="zh_CN">不支持鼠标和触摸设备</disclaimer>
        <description lang="en_GB">Terminal 80 is a dark, phosphor-green Kodi skin inspired by computer terminals from the late 1980s and 1990s.</description>
        <description lang="hu_HU">A Terminal 80 sötét, foszforzöld Kodi-felület, amelyet az 1980-as évek végének és az 1990-es éveknek a számítógépes termináljai ihlettek.</description>
        <description lang="it_IT">Terminal 80 è una skin scura per Kodi, in verde fosforo, ispirata ai terminali informatici della fine degli anni Ottanta e degli anni Novanta.</description>
        <description lang="zh_CN">Terminal 80 是一款深色荧光绿 Kodi 皮肤，灵感来自 20 世纪 80 年代末和 90 年代的计算机终端。</description>
        <license>CC-NC-SA 3.0</license>
        <website>https://github.com/NeonLightning/kodiskin</website>
        <assets>
            <icon>icon.png</icon>
            <fanart>extras/backgrounds/terminal80_home.jpg</fanart>
            <screenshot>extras/viewthumbs/57.jpg</screenshot>
            <screenshot>extras/screenshots/home.jpg</screenshot>
            <screenshot>extras/screenshots/amber.jpg</screenshot>
            <screenshot>extras/viewthumbs/500.jpg</screenshot>
            <screenshot>extras/viewthumbs/553.jpg</screenshot>
            <screenshot>extras/viewthumbs/535.jpg</screenshot>
            <screenshot>extras/screenshots/view-picker.jpg</screenshot>
            <screenshot>extras/screenshots/spinner-picker.jpg</screenshot>
            <screenshot>extras/screenshots/confirmation.jpg</screenshot>
        </assets>
    </extension>
</addon>
</addons>

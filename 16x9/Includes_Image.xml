    <expression name="Exp_HasTMDbNetworkLogo">[$EXP[Exp_MatchingTMDbItem] + !String.IsEmpty(Window(Home).Property(TMDbHelper.ListItem.Network.1.Icon)) + [String.IsEmpty(ListItem.Property(Network)) | String.IsEqual(ListItem.Property(Network),Window(Home).Property(TMDbHelper.ListItem.Network.1.Name))]]</expression>
    <expression name="Exp_HasTMDbStudioLogo">[$EXP[Exp_MatchingTMDbItem] + !String.IsEmpty(Window(Home).Property(TMDbHelper.ListItem.Studio.1.Icon)) + [String.IsEmpty(ListItem.Property(Studio)) | String.IsEqual(ListItem.Property(Studio),Window(Home).Property(TMDbHelper.ListItem.Studio.1.Name))]]</expression>
    <expression name="Exp_HasMediaNetworkLogo">[!String.IsEmpty(ListItem.Art(network)) | !String.IsEmpty(ListItem.Property(Network.1.Icon)) | $EXP[Exp_HasTMDbNetworkLogo]]</expression>
    <expression name="Exp_HasMediaStudioLogo">[!String.IsEmpty(ListItem.Art(studio)) | !String.IsEmpty(ListItem.Property(Studio.1.Icon)) | $EXP[Exp_HasTMDbStudioLogo]]</expression>

